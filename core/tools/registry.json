    "schema": {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a bounded UTF-8 workspace file range and return its full-byte SHA-256 revision, line range, mode and newline style. Use that revision for edit_files. Symlinks and binary files require explicit Python/Bash.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 0
            },
            "max_chars": {
              "type": "integer",
              "minimum": 128,
              "maximum": 64000
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    },
    "command": [
      "/usr/bin/python3",
      "-I",
      "-S",
      "{tool_root}/workspace_files.py",
      "read_file"
    ],
    "output": "json",
    "max_output": 524288
