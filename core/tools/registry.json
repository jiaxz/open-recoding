                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 32
            },
            "upgrade": {
              "type": "boolean"
            },
            "no_index": {
              "type": "boolean"
            },
            "no_deps": {
              "type": "boolean"
            }
          },
          "required": [
            "packages"
          ],
          "additionalProperties": false
        }
      }
    },
    "command": [
      "/usr/bin/python3",
      "-I",
      "-S",
      "{tool_root}/install_packages.py"
    ],
    "output": "text"
  },
